[sub_resource type="Shader" id="Shader_j6bga"]
code = "
shader_type spatial;
render_mode unshaded, cull_disabled, depth_test_disabled, shadows_disabled;
uniform sampler2D cara : source_color, filter_linear_mipmap;
uniform vec4 borde : source_color = vec4(1.0);
uniform vec2 centro = vec2(0.5);
uniform float lado = 1.0;
void vertex() {
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], INV_VIEW_MATRIX[1], INV_VIEW_MATRIX[2], MODEL_MATRIX[3]);
}
void fragment() {
	vec2 c = UV - 0.5;
	float d = length(c);
	if (d > 0.5) discard;
	vec2 t = vec2(textureSize(cara, 0));
	float m = min(t.x, t.y);
	vec2 l = vec2(lado * m / t.x, lado * m / t.y);
	vec2 cc = clamp(centro, l * 0.5, 1.0 - l * 0.5);
	vec3 col = texture(cara, cc + c / 0.84 * l).rgb;
	if (d > 0.42) col = borde.rgb;
	if (d > 0.47) col = vec3(0.03, 0.05, 0.08);
	ALBEDO = col;
}
"

