theme_override_fonts/font = ExtResource("3_fuente")
theme_override_font_sizes/font_size = 22
text = "PILTOVER, LA CIUDAD DEL PROGRESO"

[node name="Parrafo1" type="RichTextLabel" parent="ContenedorPrincipal/CuerpoCodice/PanelContenido/ContenidoCultura/PaginaCultura/DesplazamientoCultura/OpcionesCultura" unique_id=1946269456]
layout_mode = 2
theme_override_colors/default_color = Color(0.17, 0.13, 0.09, 1)
theme_override_fonts/normal_font = ExtResource("4_texto")
theme_override_font_sizes/normal_font_size = 19
bbcode_enabled = true
text = "Gobernada por un Consejo de grandes familias. Valora el [color=#7a5d22]progreso[/color], la ciencia y el buen nombre. El Día del Progreso se celebra cada año."
fit_content = true

[node name="Subtitulo2" type="Label" parent="ContenedorPrincipal/CuerpoCodice/PanelContenido/ContenidoCultura/PaginaCultura/DesplazamientoCultura/OpcionesCultura" unique_id=1977307018]
layout_mode = 2
theme_override_colors/font_color = Color(0.48, 0.36, 0.13, 1)
theme_override_fonts/font = ExtResource("3_fuente")
theme_override_font_sizes/font_size = 22
text = "ZAUN, LA CIUDAD DE ABAJO"

[node name="Parrafo2" type="RichTextLabel" parent="ContenedorPrincipal/CuerpoCodice/PanelContenido/ContenidoCultura/PaginaCultura/DesplazamientoCultura/OpcionesCultura" unique_id=659258012]
layout_mode = 2
theme_override_colors/default_color = Color(0.17, 0.13, 0.09, 1)
theme_override_fonts/normal_font = ExtResource("4_texto")
theme_override_font_sizes/normal_font_size = 19
bbcode_enabled = true
text = "Vive bajo el humo de las fábricas. Aquí se sobrevive con ingenio, lealtad al barrio y [color=#7a2a8c]quimtec[/color]. Nadie de arriba entiende sus reglas."
fit_content = true

[node name="Subtitulo3" type="Label" parent="ContenedorPrincipal/CuerpoCodice/PanelContenido/ContenidoCultura/PaginaCultura/DesplazamientoCultura/OpcionesCultura" unique_id=747380808]
layout_mode = 2
theme_override_colors/font_color = Color(0.48, 0.36, 0.13, 1)
theme_override_fonts/font = ExtResource("3_fuente")
theme_override_font_sizes/font_size = 22
text = "LO QUE LAS SEPARA"

[node name="Parrafo3" type="RichTextLabel" parent="ContenedorPrincipal/CuerpoCodice/PanelContenido/ContenidoCultura/PaginaCultura/DesplazamientoCultura/OpcionesCultura" unique_id=664188237]
layout_mode = 2
theme_override_colors/default_color = Color(0.17, 0.13, 0.09, 1)
theme_override_fonts/normal_font = ExtResource("4_texto")
theme_override_font_sizes/normal_font_size = 19
bbcode_enabled = true
text = "El Puente del Progreso une las dos ciudades, pero cruzarlo no es fácil. Los ejecutores vigilan a quien sube y nadie de arriba quiere bajar."
fit_content = true

