[node name="DesplazamientoBiografia" type="ScrollContainer" parent="ContenedorPrincipal/CuerpoCodice/PanelContenido/ContenidoTuHistoria/FilaHistoria/PaginaDerecha/DatosPersonaje" unique_id=513093701]
