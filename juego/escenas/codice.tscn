theme_override_colors/default_color = Color(0.17, 0.13, 0.09, 1)
theme_override_fonts/normal_font = ExtResource("4_texto")
theme_override_font_sizes/normal_font_size = 19
bbcode_enabled = true
text = "Naciste en [color=#7a2a8c]los Callejones[/color], entre el humo de las fábricas y el ruido de las tuberías. Tu familia arreglaba lo que Piltover tiraba al fondo.

Aprendiste pronto que en Zaun nadie te regala nada. Con trece años ya montabas piezas en el taller de tu barrio.

(La biografía se genera con las frases del capítulo 6 de la guía.)"
fit_content = true

