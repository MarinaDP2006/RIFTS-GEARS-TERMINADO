[node name="Subtitulo1" type="Label" parent="ContenedorPrincipal/CuerpoCodice/PanelContenido/ContenidoCultura/PaginaCultura/DesplazamientoCultura/OpcionesCultura" unique_id=1304927388]
layout_mode = 2
