[node name="Biografia" type="RichTextLabel" parent="ContenedorPrincipal/CuerpoCodice/PanelContenido/ContenidoTuHistoria/FilaHistoria/PaginaDerecha/DatosPersonaje/DesplazamientoBiografia" unique_id=929875400]
layout_mode = 2
